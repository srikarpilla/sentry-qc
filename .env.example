# Sentry QC — Environment Configuration
# Copy to .env and adjust as needed

# Model file paths (relative to project root)
MODEL_PATH=outputs/final_model.keras
CLASS_NAMES_PATH=outputs/class_names.json
THRESHOLD_PATH=outputs/threshold.json

# Uncertain band: P(good) within [threshold - band, threshold + band] = "uncertain"
UNCERTAIN_BAND=0.10

# Test-Time Augmentation: set to true to enable (default: false)
USE_TTA=false

# CORS allowed origins (comma-separated list as JSON array)
# CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# Max batch size
MAX_BATCH_SIZE=16
